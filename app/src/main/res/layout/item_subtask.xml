<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:minHeight="48dp"
android:paddingTop="2dp"
android:paddingBottom="2dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_subtask_done"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/cd_task_checkbox"
        android:minWidth="48dp"
        android:minHeight="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subtask_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.TodoNotes.Body"
        android:textColor="@color/color_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_subtask"
        app:layout_constraintStart_toEndOf="@id/cb_subtask_done"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Viết kiểm thử đơn vị cho ViewModel" />

    <ImageButton
        android:id="@+id/btn_remove_subtask"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_delete_item"
        android:src="@drawable/ic_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_text_secondary" />

</androidx.constraintlayout.widget.ConstraintLayout>
