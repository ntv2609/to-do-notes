<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/card_task_item"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="8dp"
android:clickable="true"
android:focusable="true"
android:foreground="?attr/selectableItemBackground"
app:cardBackgroundColor="@color/color_surface"
app:cardCornerRadius="@dimen/radius_card"
app:cardElevation="0dp"
app:strokeColor="@color/color_divider"
app:strokeWidth="@dimen/stroke_hairline">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="12dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_task_completed"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_task_checkbox"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.TodoNotes.ItemTitle"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_task"
            app:layout_constraintStart_toEndOf="@id/cb_task_completed"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Hoan thanh bao cao mon Lap trinh Android" />

        <TextView
            android:id="@+id/tv_task_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.TodoNotes.Body"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_task"
            app:layout_constraintStart_toEndOf="@id/cb_task_completed"
            app:layout_constraintTop_toBottomOf="@id/tv_task_title"
            tools:text="Ra soat 15 Use Case va kiem thu Room DAO" />

        <LinearLayout
            android:id="@+id/layout_task_badges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_task"
            app:layout_constraintStart_toEndOf="@id/cb_task_completed"
            app:layout_constraintTop_toBottomOf="@id/tv_task_description">

            <TextView
                android:id="@+id/tv_badge_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.TodoNotes.Badge"
                app:drawableStartCompat="@drawable/bg_priority_dot"
                tools:text="Cao" />

            <TextView
                android:id="@+id/tv_badge_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.TodoNotes.Caption"
                android:textColor="@color/color_text_secondary"
                tools:text="Hoc tap" />

            <TextView
                android:id="@+id/tv_badge_subtasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextAppearance.TodoNotes.Caption"
                android:visibility="gone"
                tools:text="1/3 muc con"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_task_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_task"
            app:layout_constraintStart_toEndOf="@id/cb_task_completed"
            app:layout_constraintTop_toBottomOf="@id/layout_task_badges"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_task_due_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TodoNotes.Caption"
                tools:text="20/11/2026 14:00" />

            <ImageView
                android:id="@+id/iv_task_reminder"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alarm"
                android:visibility="gone"
                app:tint="@color/color_primary"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_delete_task"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.55"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_item"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_text_secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
