<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/color_background">

    <!-- Dai tom tat tien do gon 1 hang -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginEnd="@dimen/screen_margin"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/color_divider"
        app:strokeWidth="@dimen/stroke_hairline">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tv_progress_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/progress_card_title"
                android:textAppearance="@style/TextAppearance.TodoNotes.Caption"
                android:textColor="@color/color_text_primary"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintEnd_toStartOf="@id/tv_progress_percent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_progress_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.TodoNotes.Caption"
                app:layout_constraintEnd_toStartOf="@id/tv_progress_percent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_progress_title"
                tools:text="2/4 hoan thanh • 0 qua han" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TodoNotes.HeadlineMetric"
                app:layout_constraintBottom_toBottomOf="@id/tv_progress_summary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_progress_title"
                tools:text="50%" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar_tasks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                app:indicatorColor="@color/color_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_progress_summary"
                app:trackColor="@color/color_surface_elevated"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- O tim kiem phang, nhe mat -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search_tasks"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/screen_margin"
        app:boxBackgroundColor="@color/color_surface_elevated"
        app:boxCornerRadiusBottomEnd="@dimen/radius_control"
        app:boxCornerRadiusBottomStart="@dimen/radius_control"
        app:boxCornerRadiusTopEnd="@dimen/radius_control"
        app:boxCornerRadiusTopStart="@dimen/radius_control"
        app:boxStrokeColor="@color/color_primary"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="1dp"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_progress"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/color_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_search_tasks"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingVertical="10dp"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_disabled"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Chip loc trang thai -->
    <HorizontalScrollView
        android:id="@+id/scroll_status_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_search_tasks">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_all"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_active"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_active" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_completed"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_completed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_overdue"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_overdue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_today"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_today" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Chip loc nhan phan loai -->
    <HorizontalScrollView
        android:id="@+id/scroll_category_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_status_chips">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_all"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/category_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_personal"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_personal" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_study"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_study" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_work"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_work" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_shopping"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_shopping" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_other"
                style="@style/Widget.TodoNotes.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_other" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="4dp"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_category_chips"
        tools:listitem="@layout/item_task" />

    <!-- Trang thai rong gian di -->
    <LinearLayout
        android:id="@+id/layout_empty_tasks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_category_chips"
        tools:visibility="visible">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_task"
            app:tint="@color/color_text_disabled" />

        <TextView
            android:id="@+id/tv_empty_tasks_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/empty_tasks_title"
            android:textAppearance="@style/TextAppearance.TodoNotes.ItemTitle" />

        <TextView
            android:id="@+id/tv_empty_tasks_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/empty_tasks_subtitle"
            android:textAppearance="@style/TextAppearance.TodoNotes.Body" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
