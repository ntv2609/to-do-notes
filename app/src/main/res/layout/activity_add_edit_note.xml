<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/layout_root_add_edit_note"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/note_color_0_bg"
android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_add_edit_note"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_surface"
        android:elevation="2dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_add_note"
        app:titleTextAppearance="@style/TextAppearance.TodoNotes.ToolbarTitle"
        app:titleTextColor="@color/color_text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/color_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_note_color"
                android:textAppearance="@style/TextAppearance.TodoNotes.Caption" />

            <LinearLayout
                android:id="@+id/layout_color_palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="8dp">

                <ImageButton
                    android:id="@+id/btn_color_0"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_color_swatch"
                    android:contentDescription="@string/label_note_color"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btn_color_1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_color_swatch"
                    android:contentDescription="@string/label_note_color"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btn_color_2"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_color_swatch"
                    android:contentDescription="@string/label_note_color"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btn_color_3"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_color_swatch"
                    android:contentDescription="@string/label_note_color"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btn_color_4"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_color_swatch"
                    android:contentDescription="@string/label_note_color"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btn_color_5"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_color_swatch"
                    android:contentDescription="@string/label_note_color"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:alpha="0.45"
                android:background="@color/color_divider" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_note_title"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_note_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/hint_note_title"
                    android:inputType="textCapSentences"
                    android:maxLength="200"
                    android:maxLines="2"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="10dp"
                    android:textAppearance="@style/TextAppearance.TodoNotes.EditorTitle"
                    android:textColorHint="@color/color_text_disabled" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_note_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_note_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/hint_note_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingExtra="5dp"
                    android:maxLength="20000"
                    android:minLines="10"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/color_text_primary"
                    android:textColorHint="@color/color_text_disabled"
                    android:textSize="15.5sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_note_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.TodoNotes.Caption"
                android:textColor="@color/color_text_secondary"
                tools:text="Cap nhat: 15/11 14:30" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
